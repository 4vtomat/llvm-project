def TuneSiFiveP400 : SubtargetFeature<"sifive-p400", "RISCVProcFamily", "SiFiveP400",
                                      "SiFive P400-Series processors">;
def TuneSiFiveP500 : SubtargetFeature<"sifive-p500", "RISCVProcFamily", "SiFiveP500",
                                      "SiFive P500-Series processors">;
def TuneSiFiveP600 : SubtargetFeature<"sifive-p600", "RISCVProcFamily", "SiFiveP600",
                                      "SiFive P600-Series processors">;
def TuneSiFiveP800 : SubtargetFeature<"sifive-p800", "RISCVProcFamily", "SiFiveP800",
                                      "SiFive P800-Series processors">;

def TuneSiFiveLeopard : SubtargetFeature<"sifive-leopard", "RISCVProcFamily", "SiFiveLeopard",
                                         "SiFive Leopard processors">;
def TuneSiFiveLion : SubtargetFeature<"sifive-lion", "RISCVProcFamily", "SiFiveLion",
                                      "SiFive Lion processors">;
def TuneSiFiveCheetah : SubtargetFeature<"sifive-cheetah", "RISCVProcFamily", "SiFiveCheetah",
                                         "SiFive Cheetah processors">;

def SIFIVE_6 : RISCVTuneProcessorModel<"sifive-6-series", SiFive6Model,
                                       [TuneSiFive6]>;
def SIFIVE_7M : RISCVTuneProcessorModel<"sifive-7m-series", SiFive7Model,
                                        !listconcat(SiFive7TuneFeatures,
                                                    [TunePseudoLIsimm32])>;
def SIFIVE_7N : RISCVTuneProcessorModel<"sifive-7n-series", SiFive7NModel,
                                        !listconcat(SiFive7TuneFeatures,
                                                    [TunePseudoLIsimm32])>;
def SIFIVE_7O : RISCVTuneProcessorModel<"sifive-7o-series", SiFive7NModel,
                                        !listconcat(SiFive7TuneFeatures,
                                                    [TunePseudoLIsimm32])>;

defvar SiFiveMallardTuneFeatures = [TuneNoDefaultUnroll,
                                    TuneConditionalCompressedMoveFusion,
                                    TuneLUIADDIFusion,
                                    TuneAUIPCADDIFusion,
                                    FeaturePostRAScheduler];

defvar SiFiveP400TuneFeatures = !listconcat([TuneSiFiveP400],
                                            SiFiveMallardTuneFeatures);
def SIFIVE_P400 : RISCVTuneProcessorModel<"sifive-p400-series", SiFiveP400Model,
                                          SiFiveP400TuneFeatures>;

defvar SiFiveP500TuneFeatures = !listconcat([TuneSiFiveP500],
                                            SiFiveMallardTuneFeatures);
def SIFIVE_P500 : RISCVTuneProcessorModel<"sifive-p500-series", SiFiveP500Model,
                                          SiFiveP500TuneFeatures>;

defvar SiFiveP600TuneFeatures = !listconcat([TuneSiFiveP600],
                                            SiFiveMallardTuneFeatures);
def SIFIVE_P600 : RISCVTuneProcessorModel<"sifive-p600-series", SiFiveP600Model,
                                          SiFiveP600TuneFeatures>;

