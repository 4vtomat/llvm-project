; Test all supported combinations of lowering of vcast.to.fixed and
; vcast.from.fixed intrinsics. CodeGen isn't great as they are each
; turned into copies through the stack and the results fixed side
; gets scalarized. We expect many of these intrinsics to get paired
; up and eliminated only those that aren't paired will become stack
; copies.

define i64 @test_vcast_to_fixed_64_f32m1(<vscale x 2 x float> %x) {
; CHECK-LABEL: test_vcast_to_fixed_64_f32m1:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    addi sp, sp, -32
; CHECK-NEXT:    .cfi_def_cfa_offset 32
; CHECK-NEXT:    vsetivli zero, 2, e32, m1, ta, mu
; CHECK-NEXT:    addi a0, sp, 16
; CHECK-NEXT:    vse32.v v8, (a0)
; CHECK-NEXT:    flw ft0, 20(sp)
; CHECK-NEXT:    flw ft1, 16(sp)
; CHECK-NEXT:    fmv.x.w a0, ft0
; CHECK-NEXT:    slli a0, a0, 32
; CHECK-NEXT:    fmv.x.w a1, ft1
; CHECK-NEXT:    slli a1, a1, 32
; CHECK-NEXT:    srli a1, a1, 32
; CHECK-NEXT:    or a0, a1, a0
; CHECK-NEXT:    addi sp, sp, 32
; CHECK-NEXT:    ret
;
; VLS-LABEL: test_vcast_to_fixed_64_f32m1:
; VLS:       # %bb.0: # %entry
; VLS-NEXT:    addi sp, sp, -16
; VLS-NEXT:    .cfi_def_cfa_offset 16
; VLS-NEXT:    vsetivli zero, 2, e32, m1, ta, mu
; VLS-NEXT:    addi a0, sp, 8
; VLS-NEXT:    vse32.v v8, (a0)
; VLS-NEXT:    ld a0, 8(sp)
; VLS-NEXT:    addi sp, sp, 16
; VLS-NEXT:    ret
entry:
  %0 = tail call <2 x float> @llvm.riscv.vcast.to.fixed.v2f32.nxv2f32(<vscale x 2 x float> %x)
  %1 = bitcast <2 x float> %0 to i64
  ret i64 %1
}

