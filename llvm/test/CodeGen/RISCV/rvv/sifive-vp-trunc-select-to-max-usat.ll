; CHECK-NEXT:    vsetvli zero, a0, e64, m2, ta, ma
; CHECK-NEXT:    vmax.vx v8, v8, zero, v0.t
; CHECK-NEXT:    li a0, -1
; CHECK-NEXT:    srli a0, a0, 32
; CHECK-NEXT:    vmin.vx v8, v8, a0, v0.t
; CHECK-NEXT:    vsetvli zero, zero, e32, m1, ta, ma
; CHECK-NEXT:    vnsrl.wi v8, v8, 0, v0.t
; CHECK-NEXT:    ret
  %a = call <4 x i1> @llvm.vp.icmp.v4i64(<4 x i64> %x, <4 x i64> zeroinitializer, metadata !"sgt", <4 x i1> %m, i32 %evl)
  %b = call <4 x i64> @llvm.vp.sext.v4i64.v4i1(<4 x i1> %a, <4 x i1> %m, i32 %evl)
  %c = call <4 x i1> @llvm.vp.icmp.v4i64(<4 x i64> %x, <4 x i64> splat (i64 4294967296), metadata !"ult", <4 x i1> %m, i32 %evl)
  %d = call <4 x i64> @llvm.vp.select.v4i64(<4 x i1> %c, <4 x i64> %x, <4 x i64> %b, i32 %evl)
  %e = call <4 x i32> @llvm.vp.trunc.v4i32.v4i64(<4 x i64> %d, <4 x i1> %m, i32 %evl)
  ret <4 x i32> %e
}
