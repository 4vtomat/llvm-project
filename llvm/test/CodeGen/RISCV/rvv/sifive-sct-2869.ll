; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc < %s -mtriple=riscv64 -mattr=+zve32f | FileCheck %s

%struct.d = type { i32, [0 x %struct.c] }
%struct.c = type { ptr, ptr }

; This regression test exists because the there was a crash in
; RISCVTargetLowering::PerformDAGCombine as a result of building a v1i32
; constant using an i64 constant, without truncating appropriatley.
; The crash happened from the following SDNode:
;   v1i32 = BUILD_VECTOR Constant:i64<0>
define i64 @g() {
; CHECK-LABEL: g:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    lui a0, %hi(g)
; CHECK-NEXT:    addi a0, a0, %lo(g)
; CHECK-NEXT:    sd zero, 8(a0)
; CHECK-NEXT:    sd zero, 16(a0)
; CHECK-NEXT:    ret
entry:
  tail call void @llvm.memset.p0.i64(ptr noundef nonnull align 8 dereferenceable(16) getelementptr inbounds (%struct.d, ptr @g, i64 0, i32 1), i8 0, i64 16, i1 false)
  ret i64 undef
}

declare void @llvm.memset.p0.i64(ptr nocapture writeonly, i8, i64, i1 immarg)
