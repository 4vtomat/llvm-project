    ; CHECK-NEXT: [[SRLI2:%[0-9]+]]:gpr = SRLI [[COPY3]], 32
    ; CHECK-NEXT: [[SRLI3:%[0-9]+]]:gpr = SRLI [[COPY2]], 32
    ; CHECK-NEXT: [[SRLI4:%[0-9]+]]:gpr = SRLI [[COPY5]], 32
    ; CHECK-NEXT: [[SRLI5:%[0-9]+]]:gpr = SRLI [[COPY4]], 32
    ; CHECK-NEXT: [[LD:%[0-9]+]]:gpr = LD %fixed-stack.2, 0 :: (load (s64) from %fixed-stack.2, align 16)
    ; CHECK-NEXT: SW [[COPY4]], %stack.0, 8 :: (store (s32) into %stack.0 + 8, align 8, basealign 16)
    ; CHECK-NEXT: SW [[COPY5]], %stack.0, 0 :: (store (s32) into %stack.0, align 16)
    ; CHECK-NEXT: SW killed [[SRLI5]], %stack.0, 12 :: (store (s32) into %stack.0 + 12, basealign 16)
    ; CHECK-NEXT: SW killed [[SRLI4]], %stack.0, 4 :: (store (s32) into %stack.0 + 4, basealign 16)
    ; CHECK-NEXT: [[PseudoVLE32_V_M2_:%[0-9]+]]:vrm2 = PseudoVLE32_V_M2 %stack.0, 4, 5 /* e32 */
    ; CHECK-NEXT: SW [[COPY2]], %stack.1, 8 :: (store (s32) into %stack.1 + 8, align 8, basealign 16)
    ; CHECK-NEXT: SW [[COPY3]], %stack.1, 0 :: (store (s32) into %stack.1, align 16)
    ; CHECK-NEXT: SW killed [[SRLI3]], %stack.1, 12 :: (store (s32) into %stack.1 + 12, basealign 16)
    ; CHECK-NEXT: SW killed [[SRLI2]], %stack.1, 4 :: (store (s32) into %stack.1 + 4, basealign 16)
    ; CHECK-NEXT: [[PseudoVLE32_V_M2_1:%[0-9]+]]:vrm2 = PseudoVLE32_V_M2 %stack.1, 4, 5 /* e32 */
    ; CHECK-NEXT: [[ReadVXRM:%[0-9]+]]:gpr = ReadVXRM implicit $vxrm
    ; CHECK-NEXT: WriteVXRMImm 2, implicit-def dead $vxrm
    ; CHECK-NEXT: [[PseudoVAADD_VV_M2_:%[0-9]+]]:vrm2 = PseudoVAADD_VV_M2 [[PseudoVLE32_V_M2_]], killed [[PseudoVLE32_V_M2_1]], 4, 4, 5 /* e32 */, implicit $vxrm
    ; CHECK-NEXT: SW [[COPY]], %stack.2, 8 :: (store (s32) into %stack.2 + 8, align 8, basealign 16)
    ; CHECK-NEXT: SW [[COPY1]], %stack.2, 0 :: (store (s32) into %stack.2, align 16)
    ; CHECK-NEXT: SW killed [[SRLI1]], %stack.2, 12 :: (store (s32) into %stack.2 + 12, basealign 16)
    ; CHECK-NEXT: SW killed [[SRLI]], %stack.2, 4 :: (store (s32) into %stack.2 + 4, basealign 16)
    ; CHECK-NEXT: [[PseudoVLE32_V_M2_2:%[0-9]+]]:vrm2 = PseudoVLE32_V_M2 %stack.2, 4, 5 /* e32 */
    ; CHECK-NEXT: [[PseudoVAADD_VV_M2_1:%[0-9]+]]:vrm2 = PseudoVAADD_VV_M2 [[PseudoVLE32_V_M2_]], killed [[PseudoVLE32_V_M2_2]], 4, 4, 5 /* e32 */, implicit $vxrm
    ; CHECK-NEXT: WriteVXRM killed [[ReadVXRM]], implicit-def dead $vxrm
    ; CHECK-NEXT: PseudoVSE32_V_M2 killed [[PseudoVAADD_VV_M2_]], [[LD]], 4, 5 /* e32 */
    ; CHECK-NEXT: PseudoVSE32_V_M2 killed [[PseudoVAADD_VV_M2_1]], [[LD]], 4, 5 /* e32 */
    ; CHECK-NEXT: PseudoRET
    %5:gpr = COPY $x15
    %4:gpr = COPY $x14
    %3:gpr = COPY $x13
    %2:gpr = COPY $x12
    %1:gpr = COPY $x11
    %0:gpr = COPY $x10
    %8:gpr = SRLI %4, 32
    %9:gpr = SRLI %5, 32
    %10:gpr = SRLI %2, 32
    %11:gpr = SRLI %3, 32
    %12:gpr = SRLI %0, 32
    %13:gpr = SRLI %1, 32
    %14:gpr = LD %fixed-stack.0, 0 :: (load (s64) from %fixed-stack.0, align 16)
    SW %1, %stack.0, 8 :: (store (s32) into %stack.0 + 8, align 8, basealign 16)
    SW %0, %stack.0, 0 :: (store (s32) into %stack.0, align 16)
    SW killed %13, %stack.0, 12 :: (store (s32) into %stack.0 + 12, basealign 16)
    SW killed %12, %stack.0, 4 :: (store (s32) into %stack.0 + 4, basealign 16)
    %15:vrm2 = PseudoVLE32_V_M2 %stack.0, 4, 5
    SW %3, %stack.1, 8 :: (store (s32) into %stack.1 + 8, align 8, basealign 16)
    SW %2, %stack.1, 0 :: (store (s32) into %stack.1, align 16)
    SW killed %11, %stack.1, 12 :: (store (s32) into %stack.1 + 12, basealign 16)
    SW killed %10, %stack.1, 4 :: (store (s32) into %stack.1 + 4, basealign 16)
    %16:vrm2 = PseudoVLE32_V_M2 %stack.1, 4, 5
    %17:gpr = ReadVXRM implicit $vxrm
    WriteVXRMImm 2, implicit-def dead $vxrm
    %18:vrm2 = PseudoVAADD_VV_M2 %15, killed %16, 4, 4, 5, implicit $vxrm
    WriteVXRM killed %17, implicit-def dead $vxrm
    SW %5, %stack.2, 8 :: (store (s32) into %stack.2 + 8, align 8, basealign 16)
    SW %4, %stack.2, 0 :: (store (s32) into %stack.2, align 16)
    SW killed %9, %stack.2, 12 :: (store (s32) into %stack.2 + 12, basealign 16)
    SW killed %8, %stack.2, 4 :: (store (s32) into %stack.2 + 4, basealign 16)
    %19:vrm2 = PseudoVLE32_V_M2 %stack.2, 4, 5
    %20:gpr = ReadVXRM implicit $vxrm
    WriteVXRMImm 2, implicit-def dead $vxrm
    %21:vrm2 = PseudoVAADD_VV_M2 %15, killed %19, 4, 4, 5, implicit $vxrm
    WriteVXRM killed %20, implicit-def dead $vxrm
    PseudoVSE32_V_M2 killed %18, %14, 4, 5
    PseudoVSE32_V_M2 killed %21, %14, 4, 5
    PseudoRET

