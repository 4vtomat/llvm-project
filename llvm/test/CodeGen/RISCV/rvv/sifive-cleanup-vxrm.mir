  - { reg: '$x11', virtual-reg: '%1' }
  - { reg: '$x12', virtual-reg: '%2' }
  - { reg: '$x13', virtual-reg: '%3' }
  - { reg: '$x14', virtual-reg: '%4' }
  - { reg: '$x15', virtual-reg: '%5' }
frameInfo:
