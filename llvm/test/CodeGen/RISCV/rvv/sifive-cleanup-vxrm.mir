callSites:       []
debugValueSubstitutions: []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0.entry:
    liveins: $x10, $x11, $x12, $x13, $x14, $x15

    ; CHECK-LABEL: name: test
    ; CHECK: liveins: $x10, $x11, $x12, $x13, $x14, $x15
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:gpr = COPY $x15
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:gpr = COPY $x14
    ; CHECK-NEXT: [[COPY2:%[0-9]+]]:gpr = COPY $x13
