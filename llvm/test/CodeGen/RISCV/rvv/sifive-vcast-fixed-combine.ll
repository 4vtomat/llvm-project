  %i9 = tail call <8 x i8> @llvm.riscv.vcast.to.fixed.v8i8.nxv8i8(<vscale x 8 x i8> %i8)
  %i11 = tail call <vscale x 8 x i8> @llvm.riscv.vcast.from.fixed.nxv8i8.v8i8(<8 x i8> %i4)
