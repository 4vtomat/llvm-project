  %i2 = bitcast i8* %x to <vscale x 8 x i8>*
  %i3 = tail call <vscale x 8 x i8> @llvm.riscv.vle.nxv8i8(<vscale x 8 x i8> undef, <vscale x 8 x i8>* %i2, i64 8)
  %i4 = tail call <8 x i8> @llvm.riscv.vcast.to.fixed.v8i8.nxv8i8(<vscale x 8 x i8> %i3)
