; CHECK-NEXT:    fmv.x.h a2, ft0
; CHECK-NEXT:    slli a2, a2, 16
; CHECK-NEXT:    or a1, a1, a2
; CHECK-NEXT:    slli a1, a1, 32
; CHECK-NEXT:    srli a1, a1, 32
; CHECK-NEXT:    or a0, a1, a0
; CHECK-NEXT:    addi sp, sp, 32
; CHECK-NEXT:    ret
