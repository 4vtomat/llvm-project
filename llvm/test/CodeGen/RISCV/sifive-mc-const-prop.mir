---
name: case2_fold
tracksRegLiveness: true
body:             |
  bb.0:
    ; RV64-LABEL: name: case2_fold
    ; RV64: renamable $x13 = ADDI $x0, 14
    ; RV32-LABEL: name: case2_fold
    ; RV32: renamable $x13 = ADDI $x0, 14
    renamable $x10 = ADDI $x0, 7
    renamable $x13 = ADDI killed renamable $x10, 6
    renamable $x13 = nuw ADDI killed renamable $x13, 1
...
---
name: case2_dont_fold
tracksRegLiveness: true
body:             |
  bb.0:
    ; RV64-LABEL: name: case2_dont_fold
    ; RV64: renamable $x10 = ADDI $x0, 2040
    ; RV64-NEXT: renamable $x13 = ADDI killed renamable $x10, 8
