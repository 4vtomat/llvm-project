    ; RV32-NEXT: renamable $x10 = XORI killed renamable $x10, 1
    ; RV32-NEXT: renamable $x10 = SLTIU killed renamable $x10, 1
    renamable $x12 = ADDI $x0, 1
    renamable $x10 = LW killed renamable $x10, 24
    renamable $x10 = XOR killed renamable $x10, killed renamable $x12
    renamable $x10 = SLTIU killed renamable $x10, 1
...
