tracksRegLiveness: true
body:             |
  bb.0:
    ; RV64-LABEL: name: case1_followed_by_case2
    ; RV64: renamable $x13 = ADDI $x0, 3
    ; RV32-LABEL: name: case1_followed_by_case2
