; CHECK-NEXT:    vmerge.vim v9, v9, 0, v0
; CHECK-NEXT:    vmv.v.v v0, v8
; CHECK-NEXT:    vmerge.vvm v8, v11, v9, v0
; CHECK-NEXT:    vse8.v v8, (a2)
; CHECK-NEXT:    ret
entry:
  %0 = load <16 x i8>, ptr %in_0, align 1
  %1 = load <16 x i8>, ptr %in_1, align 1
  %vqshlq_v.i = tail call <16 x i8> @llvm.aarch64.neon.uqshl.v16i8(<16 x i8> %0, <16 x i8> %1)
  store <16 x i8> %vqshlq_v.i, ptr %out, align 1
  ret void
}

