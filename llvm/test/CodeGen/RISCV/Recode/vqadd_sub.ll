; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    vsetivli zero, 8, e16, m1, ta, ma
; CHECK-NEXT:    vle16.v v8, (a0)
; CHECK-NEXT:    vle16.v v9, (a1)
; CHECK-NEXT:    vssub.vv v8, v8, v9
; CHECK-NEXT:    vse16.v v8, (a2)
; CHECK-NEXT:    ret
entry:
  %0 = load <8 x i16>, ptr %in_0, align 2
  %1 = load <8 x i16>, ptr %in_1, align 2
  %vqsubq_v2.i = tail call <8 x i16> @llvm.aarch64.neon.sqsub.v8i16(<8 x i16> %0, <8 x i16> %1)
  store <8 x i16> %vqsubq_v2.i, ptr %out, align 2
  ret void
}

