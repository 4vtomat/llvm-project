; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 2
; RUN: opt -passes=licm -value-liveness-enable -value-liveness-gpr-bypass %s -S | FileCheck %s

; Test Value Pressure limit prevents hoist of:
;   %invar = add nsw i32 c, 1
; into the loop preheader as the machine defaults
; are bypassed.

; Test the basic functionality of live value analysis of IR.
define ptr @bar(i64 %n, ptr noalias %a, ptr noalias %b, i32 %c) {
;
; CHECK-LABEL: define ptr @bar
; CHECK-SAME: (i64 [[N:%.*]], ptr noalias [[A:%.*]], ptr noalias [[B:%.*]], i32 [[C:%.*]]) {
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[CMP7:%.*]] = icmp sgt i64 [[N]], 0
; CHECK-NEXT:    br i1 [[CMP7]], label [[FOR_BODY_PREHEADER:%.*]], label [[FOR_COND_CLEANUP:%.*]]
; CHECK:       for.body.preheader:
; CHECK-NEXT:    br label [[FOR_BODY:%.*]]
; CHECK:       for.cond.cleanup.loopexit:
; CHECK-NEXT:    br label [[FOR_COND_CLEANUP]]
; CHECK:       for.cond.cleanup:
; CHECK-NEXT:    ret ptr [[A]]
; CHECK:       for.body:
; CHECK-NEXT:    [[INDVARS_IV:%.*]] = phi i64 [ [[N]], [[FOR_BODY_PREHEADER]] ], [ [[INDVARS_IV_NEXT:%.*]], [[FOR_BODY]] ]
; CHECK-NEXT:    [[INDVARS_IV_NEXT]] = add nsw i64 [[INDVARS_IV]], -1
; CHECK-NEXT:    [[INDVARS:%.*]] = trunc i64 [[INDVARS_IV_NEXT]] to i32
; CHECK-NEXT:    [[IDXPROM:%.*]] = zext i32 [[INDVARS]] to i64
; CHECK-NEXT:    [[ARRAYIDX:%.*]] = getelementptr inbounds i32, ptr [[B]], i64 [[IDXPROM]]
; CHECK-NEXT:    [[LD:%.*]] = load i32, ptr [[ARRAYIDX]], align 4
; CHECK-NEXT:    [[INVAR:%.*]] = add nsw i32 [[C]], 1
; CHECK-NEXT:    [[ADD:%.*]] = add nsw i32 [[INVAR]], [[LD]]
; CHECK-NEXT:    [[ARRAYIDX2:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[IDXPROM]]
; CHECK-NEXT:    store i32 [[ADD]], ptr [[ARRAYIDX2]], align 4
; CHECK-NEXT:    [[CMP:%.*]] = icmp sgt i64 [[INDVARS_IV]], 1
; CHECK-NEXT:    br i1 [[CMP]], label [[FOR_BODY]], label [[FOR_COND_CLEANUP_LOOPEXIT:%.*]]
;
entry:
  %cmp7 = icmp sgt i64 %n, 0
  br i1 %cmp7, label %for.body.preheader, label %for.cond.cleanup

for.body.preheader:                               ; preds = %entry
  br label %for.body

for.cond.cleanup:                                 ; preds = %for.cond.cleanup.loopexit, %entry
  ret ptr %a

for.body:                                         ; preds = %for.body.preheader, %for.body
  %indvars.iv = phi i64 [ %n, %for.body.preheader ], [ %indvars.iv.next, %for.body ]
  %indvars.iv.next = add nsw i64 %indvars.iv, -1
  %indvars = trunc i64 %indvars.iv.next to i32
  %idxprom = zext i32 %indvars to i64
  %arrayidx = getelementptr inbounds i32, ptr %b, i64 %idxprom
  %ld = load i32, ptr %arrayidx, align 4
  %invar = add nsw i32 %c, 1
  %add = add nsw i32 %invar, %ld
  %arrayidx2 = getelementptr inbounds i32, ptr %a, i64 %idxprom
  store i32 %add, ptr %arrayidx2, align 4
  %cmp = icmp sgt i64 %indvars.iv, 1
  br i1 %cmp, label %for.body, label %for.cond.cleanup
}
