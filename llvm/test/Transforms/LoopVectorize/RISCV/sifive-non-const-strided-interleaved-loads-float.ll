; CHECK-NEXT:    [[ARRAYIDX:%.*]] = getelementptr inbounds float, ptr [[A]], i64 [[TMP23]]
; CHECK-NEXT:    [[TMP24:%.*]] = load float, ptr [[ARRAYIDX]], align 4
; CHECK-NEXT:    [[ADD1:%.*]] = fadd fast float [[TMP24]], [[RED_069]]
; CHECK-NEXT:    [[TMP25:%.*]] = add nsw i64 [[TMP23]], 1
; CHECK-NEXT:    [[ARRAYIDX5:%.*]] = getelementptr inbounds float, ptr [[A]], i64 [[TMP25]]
; CHECK-NEXT:    [[TMP26:%.*]] = load float, ptr [[ARRAYIDX5]], align 4
; CHECK-NEXT:    [[ADD6:%.*]] = fadd fast float [[ADD1]], [[TMP26]]
; CHECK-NEXT:    [[TMP27:%.*]] = add nsw i64 [[TMP23]], 2
; CHECK-NEXT:    [[ARRAYIDX10:%.*]] = getelementptr inbounds float, ptr [[A]], i64 [[TMP27]]
; CHECK-NEXT:    [[TMP28:%.*]] = load float, ptr [[ARRAYIDX10]], align 4
; CHECK-NEXT:    [[ADD11:%.*]] = fadd fast float [[ADD6]], [[TMP28]]
; CHECK-NEXT:    [[TMP29:%.*]] = add nsw i64 [[TMP23]], 4
; CHECK-NEXT:    [[ARRAYIDX20:%.*]] = getelementptr inbounds float, ptr [[A]], i64 [[TMP29]]
; CHECK-NEXT:    [[TMP30:%.*]] = load float, ptr [[ARRAYIDX20]], align 4
; CHECK-NEXT:    [[ADD21]] = fadd fast float [[ADD11]], [[TMP30]]
; CHECK-NEXT:    [[INDVARS_IV_NEXT]] = add nuw nsw i64 [[INDVARS_IV]], 1
; CHECK-NEXT:    [[EXITCOND_NOT:%.*]] = icmp eq i64 [[INDVARS_IV_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[EXITCOND_NOT]], label [[EXIT]], label [[FOR_BODY]], !llvm.loop [[LOOP17:![0-9]+]]
; CHECK:       exit:
; CHECK-NEXT:    [[ADD21_LCSSA:%.*]] = phi float [ [[ADD21]], [[FOR_BODY]] ], [ [[TMP22]], [[MIDDLE_BLOCK]] ]
; CHECK-NEXT:    ret float [[ADD21_LCSSA]]
;

entry:
  br label %for.body

for.body:
  %indvars.iv = phi i64 [ 0, %entry ], [ %indvars.iv.next, %for.body ]
  %red.069 = phi float [ 0.000000e+00, %entry ], [ %add21, %for.body ]
  %0 = mul nsw i64 %indvars.iv, %stride
  %arrayidx = getelementptr inbounds float, ptr %a, i64 %0
  %1 = load float, ptr %arrayidx, align 4
  %add1 = fadd fast float %1, %red.069
  %2 = add nsw i64 %0, 1
  %arrayidx5 = getelementptr inbounds float, ptr %a, i64 %2
  %3 = load float, ptr %arrayidx5, align 4
  %add6 = fadd fast float %add1, %3
  %4 = add nsw i64 %0, 2
  %arrayidx10 = getelementptr inbounds float, ptr %a, i64 %4
  %5 = load float, ptr %arrayidx10, align 4
  %add11 = fadd fast float %add6, %5
  %6 = add nsw i64 %0, 4
  %arrayidx20 = getelementptr inbounds float, ptr %a, i64 %6
  %7 = load float, ptr %arrayidx20, align 4
  %add21 = fadd fast float %add11, %7
  %indvars.iv.next = add nuw nsw i64 %indvars.iv, 1
  %exitcond.not = icmp eq i64 %indvars.iv.next, %n
  br i1 %exitcond.not, label %exit, label %for.body

exit:
  ret float %add21
}
