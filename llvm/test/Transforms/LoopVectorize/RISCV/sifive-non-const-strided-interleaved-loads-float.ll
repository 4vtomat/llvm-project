  %arrayidx15 = getelementptr inbounds float, ptr %a, i64 %6
  %7 = load float, ptr %arrayidx15, align 4
  %add16 = fadd fast float %add11, %7
  %8 = add nsw i64 %0, 4
  %arrayidx20 = getelementptr inbounds float, ptr %a, i64 %8
  %9 = load float, ptr %arrayidx20, align 4
  %add21 = fadd fast float %add16, %9
  %10 = add nsw i64 %0, 5
  %arrayidx25 = getelementptr inbounds float, ptr %a, i64 %10
  %11 = load float, ptr %arrayidx25, align 4
  %add26 = fadd fast float %add21, %11
  %12 = add nsw i64 %0, 6
  %arrayidx30 = getelementptr inbounds float, ptr %a, i64 %12
  %13 = load float, ptr %arrayidx30, align 4
  %add31 = fadd fast float %add26, %13
