  %0 = load i8, ptr %end.0, align 1
  %1 = sdiv i8 %0, 2
  %cmp.not = icmp eq i8 %1, 1
  %incdec.ptr = getelementptr inbounds i8, ptr %end.0, i64 1
  br i1 %cmp.not, label %for.end, label %for.cond

