; P470-NEXT:    [[LOAD:%.*]] = load ptr, ptr [[ADDR]], align 8
; P470-NEXT:    [[ICMP:%.*]] = icmp eq ptr [[LOAD]], [[LAST]]
; P470-NEXT:    br i1 [[ICMP]], label [[RETURN_EARLY]], label [[FOR_INC]]
; P470:       for.inc:
