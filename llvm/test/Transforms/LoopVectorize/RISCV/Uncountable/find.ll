; P470-NEXT:    [[REMAIN_NEXT]] = add nsw i64 [[REMAIN]], -1
; P470-NEXT:    [[ICMP2:%.*]] = icmp sgt i64 [[REMAIN]], 1
; P470-NEXT:    br i1 [[ICMP2]], label [[FOR_BODY]], label [[RETURN]], !llvm.loop [[LOOP9:![0-9]+]]
; P470:       return.early:
