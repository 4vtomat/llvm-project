; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 5
; RUN: opt -mtriple riscv64 -mcpu=sifive-p670 -S -passes='loop-vectorize,loop-mssa(licm)' < %s | FileCheck %s

; Same exit block for both exiting blocks
; Make sure this doesn't crash in fixupIVUsers
define void @foo(ptr %arg1, i64 %arg2) {
; CHECK-LABEL: define void @foo(
; CHECK-SAME: ptr [[ARG1:%.*]], i64 [[ARG2:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[GETP1:%.*]] = getelementptr i8, ptr [[ARG1]], i64 [[ARG2]]
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[PHI1:%.*]] = phi ptr [ [[ARG1]], %[[ENTRY]] ], [ [[GEP2:%.*]], %[[LOOP_NEXT:.*]] ]
; CHECK-NEXT:    [[LOAD:%.*]] = load i8, ptr [[PHI1]], align 1
; CHECK-NEXT:    [[ICMP1:%.*]] = icmp eq i8 [[LOAD]], 37
; CHECK-NEXT:    br i1 [[ICMP1]], label %[[EXIT:.*]], label %[[LOOP_NEXT]]
; CHECK:       [[LOOP_NEXT]]:
; CHECK-NEXT:    [[GEP2]] = getelementptr i8, ptr [[PHI1]], i64 1
; CHECK-NEXT:    [[ICMP2:%.*]] = icmp ult ptr [[GEP2]], [[GETP1]]
; CHECK-NEXT:    br i1 [[ICMP2]], label %[[LOOP]], label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[PHI2:%.*]] = phi ptr [ [[GEP2]], %[[LOOP_NEXT]] ], [ [[PHI1]], %[[LOOP]] ]
; CHECK-NEXT:    ret void
;
entry:
  %getp1 = getelementptr i8, ptr %arg1, i64 %arg2
  br label %loop

loop:
  %phi1 = phi ptr [ %arg1, %entry ], [ %gep2, %loop.next ]
  %load = load i8, ptr %phi1, align 1
  %icmp1 = icmp eq i8 %load, 37
  br i1 %icmp1, label %exit, label %loop.next

loop.next:
  %gep2 = getelementptr i8, ptr %phi1, i64 1
  %icmp2 = icmp ult ptr %gep2, %getp1
  br i1 %icmp2, label %loop, label %exit

exit:
  %phi2 = phi ptr [ %gep2, %loop.next ], [ %phi1, %loop ]
  ret void
}
