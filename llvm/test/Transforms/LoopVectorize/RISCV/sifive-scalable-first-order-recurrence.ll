; CHECK-NEXT:    [[TMP0:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[TMP3:%.*]], %[[SCALAR_BODY]] ]
; CHECK-NEXT:    [[TMP3]] = add i64 0, 1
