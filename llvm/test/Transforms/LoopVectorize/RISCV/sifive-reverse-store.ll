; The shuffle cost of the store value can be saved if it is uniform
; Make sure the loop is profitable to vectorize
define void @reverse(ptr %y, i64 %alpha, i32 %N) {
; CHECK-LABEL: define void @reverse(
; CHECK-SAME: ptr [[Y:%.*]], i64 [[ALPHA:%.*]], i32 [[N:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[COND2:%.*]] = icmp eq i32 [[N]], 0
; CHECK-NEXT:    br i1 [[COND2]], label %[[EXIT:.*]], label %[[PREHEADER:.*]]
; CHECK:       [[PREHEADER]]:
; CHECK-NEXT:    [[TMP0:%.*]] = sext i32 [[N]] to i64
; CHECK-NEXT:    br label %[[WHILE_BODY:.*]]
; CHECK:       [[WHILE_BODY]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ [[TMP0]], %[[PREHEADER]] ], [ [[IV_NEXT:%.*]], %[[WHILE_BODY]] ]
; CHECK-NEXT:    [[IV_NEXT]] = add nsw i64 [[IV]], -1
; CHECK-NEXT:    [[ARRAYIDX:%.*]] = getelementptr inbounds i64, ptr [[Y]], i64 [[IV_NEXT]]
; CHECK-NEXT:    store i64 [[ALPHA]], ptr [[ARRAYIDX]], align 8
; CHECK-NEXT:    [[COND:%.*]] = icmp eq i64 [[IV_NEXT]], 0
; CHECK-NEXT:    br i1 [[COND]], label %[[EXIT_LOOPEXIT:.*]], label %[[WHILE_BODY]]
; CHECK:       [[EXIT_LOOPEXIT]]:
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %cond2 = icmp eq i32 %N, 0
  br i1 %cond2, label %exit, label %preheader

preheader:
  %0 = sext i32 %N to i64
  br label %while.body

while.body:
  %iv = phi i64 [ %0, %preheader ], [ %iv.next, %while.body ]
  %iv.next = add nsw i64 %iv, -1
  %arrayidx = getelementptr inbounds i64, ptr %y, i64 %iv.next
  store i64 %alpha, ptr %arrayidx
  %cond = icmp eq i64 %iv.next, 0
  br i1 %cond, label %exit, label %while.body

exit:
  ret void
}
