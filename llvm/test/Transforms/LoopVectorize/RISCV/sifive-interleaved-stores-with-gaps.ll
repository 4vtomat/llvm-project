; CHECK-NEXT:    [[ARRAYIDX:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[TMP27]]
; CHECK-NEXT:    [[TMP28:%.*]] = trunc i64 [[INDVARS_IV]] to i32
; CHECK-NEXT:    store i32 [[TMP28]], ptr [[ARRAYIDX]], align 4
; CHECK-NEXT:    [[TMP29:%.*]] = or disjoint i64 [[TMP27]], 1
; CHECK-NEXT:    [[ARRAYIDX4:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[TMP29]]
; CHECK-NEXT:    store i32 [[TMP28]], ptr [[ARRAYIDX4]], align 4
; CHECK-NEXT:    [[TMP30:%.*]] = or disjoint i64 [[TMP27]], 2
; CHECK-NEXT:    [[ARRAYIDX8:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[TMP30]]
; CHECK-NEXT:    store i32 [[TMP28]], ptr [[ARRAYIDX8]], align 4
; CHECK-NEXT:    [[TMP31:%.*]] = or disjoint i64 [[TMP27]], 3
; CHECK-NEXT:    [[ARRAYIDX12:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[TMP31]]
; CHECK-NEXT:    store i32 [[TMP28]], ptr [[ARRAYIDX12]], align 4
; CHECK-NEXT:    [[TMP32:%.*]] = or disjoint i64 [[TMP27]], 4
; CHECK-NEXT:    [[ARRAYIDX16:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[TMP32]]
; CHECK-NEXT:    store i32 [[TMP28]], ptr [[ARRAYIDX16]], align 4
; CHECK-NEXT:    [[TMP33:%.*]] = or disjoint i64 [[TMP27]], 5
; CHECK-NEXT:    [[ARRAYIDX20:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[TMP33]]
; CHECK-NEXT:    store i32 [[TMP28]], ptr [[ARRAYIDX20]], align 4
; CHECK-NEXT:    [[TMP34:%.*]] = or disjoint i64 [[TMP27]], 7
; CHECK-NEXT:    [[ARRAYIDX24:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[TMP34]]
; CHECK-NEXT:    store i32 [[TMP28]], ptr [[ARRAYIDX24]], align 4
; CHECK-NEXT:    [[INDVARS_IV_NEXT]] = add nuw nsw i64 [[INDVARS_IV]], 1
; CHECK-NEXT:    [[EXITCOND_NOT:%.*]] = icmp eq i64 [[INDVARS_IV_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[EXITCOND_NOT]], label [[EXIT]], label [[FOR_BODY]], !llvm.loop [[LOOP28:![0-9]+]]
; CHECK:       exit:
; CHECK-NEXT:    ret void
