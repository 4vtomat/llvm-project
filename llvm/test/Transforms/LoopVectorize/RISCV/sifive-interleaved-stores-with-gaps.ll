entry:
  br label %for.body

for.body:
  %indvars.iv = phi i64 [ 0, %entry ], [ %indvars.iv.next, %for.body ]
  %0 = shl nsw i64 %indvars.iv, 3
  %arrayidx = getelementptr inbounds i32, ptr %a, i64 %0
  %1 = trunc i64 %indvars.iv to i32
  store i32 %1, ptr %arrayidx, align 4
  %2 = or disjoint i64 %0, 1
  %arrayidx4 = getelementptr inbounds i32, ptr %a, i64 %2
  store i32 %1, ptr %arrayidx4, align 4
  %3 = or disjoint i64 %0, 2
  %arrayidx8 = getelementptr inbounds i32, ptr %a, i64 %3
  store i32 %1, ptr %arrayidx8, align 4
  %4 = or disjoint i64 %0, 3
  %arrayidx12 = getelementptr inbounds i32, ptr %a, i64 %4
  store i32 %1, ptr %arrayidx12, align 4
  %5 = or disjoint i64 %0, 4
  %arrayidx16 = getelementptr inbounds i32, ptr %a, i64 %5
  store i32 %1, ptr %arrayidx16, align 4
  %6 = or disjoint i64 %0, 5
  %arrayidx20 = getelementptr inbounds i32, ptr %a, i64 %6
  store i32 %1, ptr %arrayidx20, align 4
  %7 = or disjoint i64 %0, 7
  %arrayidx24 = getelementptr inbounds i32, ptr %a, i64 %7
  store i32 %1, ptr %arrayidx24, align 4
  %indvars.iv.next = add nuw nsw i64 %indvars.iv, 1
  %exitcond.not = icmp eq i64 %indvars.iv.next, %n
  br i1 %exitcond.not, label %exit, label %for.body

exit:
  ret void
}

