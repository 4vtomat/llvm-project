; CHECK-NEXT:    [[COND:%.*]] = icmp eq ptr [[P_0]], [[VAL]]
; CHECK-NEXT:    br i1 [[COND]], label %[[FOR_COND_CLEANUP:.*]], label %[[FOR_BODY]]
; CHECK:       [[FOR_COND_CLEANUP]]:
; CHECK-NEXT:    ret void
; CHECK:       [[FOR_BODY]]:
; CHECK-NEXT:    store i40 0, ptr [[P_0]], align 4
; CHECK-NEXT:    [[INCDEC_PTR]] = getelementptr inbounds i8, ptr [[P_0]], i64 8
; CHECK-NEXT:    br label %[[FOR_COND]]
;
entry:
  br label %for.cond

for.cond:
  %P.0 = phi ptr [ null, %entry ], [ %incdec.ptr, %for.body ]
