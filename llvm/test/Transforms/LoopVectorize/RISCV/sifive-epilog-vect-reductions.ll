; CHECK-NO-POSTSV-NEXT:    [[XOR]] = or i32 [[SUM_02]], [[EXT]]
; CHECK-NO-POSTSV-NEXT:    [[IV_NEXT]] = add i32 [[IV]], 1
; CHECK-NO-POSTSV-NEXT:    [[EXITCOND:%.*]] = icmp eq i32 [[IV_NEXT]], 256
; CHECK-NO-POSTSV-NEXT:    br i1 [[EXITCOND]], label [[FOR_END]], label [[FOR_BODY]], !llvm.loop [[LOOP10:![0-9]+]]
; CHECK-NO-POSTSV:       for.end:
