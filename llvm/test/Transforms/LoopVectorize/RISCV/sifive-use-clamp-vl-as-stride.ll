; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
; RUN: opt -S -vectorize-with-known-depdist=true -passes=loop-vectorize -riscv-use-vla-vectorizer=true -mtriple=riscv64 -mattr=+d,+v -riscv-v-vector-bits-min=512 %s | FileCheck %s

; This test checks to make sure that the stride of pointer access in the vector loop is the maximum safe number of elements, opposed to the number of unrolled elements.

%struct = type <{ ptr, double }>
%struct2 = type <{ ptr, ptr, ptr }>

define void @widget(ptr %a, i64 %n) {
; CHECK-LABEL: @widget(
; CHECK-NEXT:  ph:
; CHECK-NEXT:    [[B:%.*]] = getelementptr inbounds [[STRUCT2:%.*]], ptr [[A:%.*]], i64 0, i32 2
; CHECK-NEXT:    [[TMP0:%.*]] = add i64 [[N:%.*]], 1
; CHECK-NEXT:    [[UMIN:%.*]] = call i64 @llvm.umin.i64(i64 [[N]], i64 1)
; CHECK-NEXT:    [[TMP1:%.*]] = sub i64 [[TMP0]], [[UMIN]]
; CHECK-NEXT:    [[MIN_ITERS_CHECK:%.*]] = icmp ult i64 [[TMP1]], 2
; CHECK-NEXT:    br i1 [[MIN_ITERS_CHECK]], label [[SCALAR_PH:%.*]], label [[VECTOR_PH:%.*]]
; CHECK:       vector.ph:
; CHECK-NEXT:    [[EVL_BASED_IV:%.*]] = urem i64 [[TMP1]], 2
; CHECK-NEXT:    [[TMP4:%.*]] = sub i64 [[TMP1]], [[EVL_BASED_IV]]
; CHECK-NEXT:    [[TMP2:%.*]] = sub i64 [[N]], [[TMP4]]
; CHECK-NEXT:    [[OFFSET_IDX:%.*]] = mul i64 [[TMP4]], -16
; CHECK-NEXT:    [[NEXT_GEP:%.*]] = getelementptr i8, ptr [[A]], i64 [[OFFSET_IDX]]
; CHECK-NEXT:    [[OFFSET_IDX5:%.*]] = mul i64 [[TMP4]], -16
; CHECK-NEXT:    [[NEXT_GEP6:%.*]] = getelementptr i8, ptr [[B]], i64 [[OFFSET_IDX5]]
; CHECK-NEXT:    br label [[VECTOR_BODY:%.*]]
; CHECK:       vector.body:
; CHECK-NEXT:    [[INDEX:%.*]] = phi i64 [ 0, [[VECTOR_PH]] ], [ [[INDEX_NEXT:%.*]], [[VECTOR_BODY]] ]
; CHECK-NEXT:    [[POINTER_PHI:%.*]] = phi ptr [ [[A]], [[VECTOR_PH]] ], [ [[PTR_IND:%.*]], [[VECTOR_BODY]] ]
; CHECK-NEXT:    [[POINTER_PHI1:%.*]] = phi ptr [ [[B]], [[VECTOR_PH]] ], [ [[PTR_IND2:%.*]], [[VECTOR_BODY]] ]
; CHECK-NEXT:    [[VECTOR_GEP:%.*]] = getelementptr i8, ptr [[POINTER_PHI]], <2 x i64> <i64 0, i64 -16>
; CHECK-NEXT:    [[VECTOR_GEP3:%.*]] = getelementptr i8, ptr [[POINTER_PHI1]], <2 x i64> <i64 0, i64 -16>
; CHECK-NEXT:    [[TMP7:%.*]] = getelementptr [[STRUCT:%.*]], <2 x ptr> [[VECTOR_GEP3]], i64 -1, i32 0
; CHECK-NEXT:    [[WIDE_MASKED_GATHER:%.*]] = call <2 x ptr> @llvm.masked.gather.v2p0.v2p0(<2 x ptr> [[TMP7]], i32 8, <2 x i1> splat (i1 true), <2 x ptr> poison)
; CHECK-NEXT:    [[TMP8:%.*]] = getelementptr [[STRUCT]], <2 x ptr> [[VECTOR_GEP]], i64 -2, i32 0
; CHECK-NEXT:    call void @llvm.masked.scatter.v2p0.v2p0(<2 x ptr> [[WIDE_MASKED_GATHER]], <2 x ptr> [[TMP8]], i32 8, <2 x i1> splat (i1 true))
; CHECK-NEXT:    [[TMP9:%.*]] = getelementptr [[STRUCT]], <2 x ptr> [[VECTOR_GEP3]], i64 -1, i32 1
; CHECK-NEXT:    [[WIDE_MASKED_GATHER4:%.*]] = call <2 x double> @llvm.masked.gather.v2f64.v2p0(<2 x ptr> [[TMP9]], i32 8, <2 x i1> splat (i1 true), <2 x double> poison)
; CHECK-NEXT:    [[TMP10:%.*]] = getelementptr [[STRUCT]], <2 x ptr> [[VECTOR_GEP]], i64 -2, i32 1
; CHECK-NEXT:    call void @llvm.masked.scatter.v2f64.v2p0(<2 x double> [[WIDE_MASKED_GATHER4]], <2 x ptr> [[TMP10]], i32 8, <2 x i1> splat (i1 true))
; CHECK-NEXT:    [[INDEX_NEXT]] = add nuw i64 [[INDEX]], 2
; CHECK-NEXT:    [[PTR_IND]] = getelementptr i8, ptr [[POINTER_PHI]], i64 -32
; CHECK-NEXT:    [[PTR_IND2]] = getelementptr i8, ptr [[POINTER_PHI1]], i64 -32
; CHECK-NEXT:    [[TMP11:%.*]] = icmp eq i64 [[INDEX_NEXT]], [[TMP4]]
; CHECK-NEXT:    br i1 [[TMP11]], label [[MIDDLE_BLOCK:%.*]], label [[VECTOR_BODY]], !llvm.loop [[LOOP0:![0-9]+]]
; CHECK:       middle.block:
; CHECK-NEXT:    [[CMP_N:%.*]] = icmp eq i64 [[TMP1]], [[TMP4]]
; CHECK-NEXT:    br i1 [[CMP_N]], label [[EXIT:%.*]], label [[SCALAR_PH]]
; CHECK:       scalar.ph:
; CHECK-NEXT:    [[BC_RESUME_VAL:%.*]] = phi i64 [ [[TMP2]], [[MIDDLE_BLOCK]] ], [ [[N]], [[PH:%.*]] ]
; CHECK-NEXT:    [[BC_RESUME_VAL5:%.*]] = phi ptr [ [[NEXT_GEP]], [[MIDDLE_BLOCK]] ], [ [[A]], [[PH]] ]
; CHECK-NEXT:    [[BC_RESUME_VAL6:%.*]] = phi ptr [ [[NEXT_GEP6]], [[MIDDLE_BLOCK]] ], [ [[B]], [[PH]] ]
; CHECK-NEXT:    br label [[LOOP:%.*]]
; CHECK:       loop:
; CHECK-NEXT:    [[TMP31:%.*]] = phi i64 [ [[BC_RESUME_VAL]], [[SCALAR_PH]] ], [ [[IV:%.*]], [[LOOP]] ]
; CHECK-NEXT:    [[TMP32:%.*]] = phi ptr [ [[BC_RESUME_VAL5]], [[SCALAR_PH]] ], [ [[TMP34:%.*]], [[LOOP]] ]
; CHECK-NEXT:    [[TMP33:%.*]] = phi ptr [ [[BC_RESUME_VAL6]], [[SCALAR_PH]] ], [ [[TMP35:%.*]], [[LOOP]] ]
; CHECK-NEXT:    [[TMP34]] = getelementptr inbounds [[STRUCT]], ptr [[TMP32]], i64 -1
; CHECK-NEXT:    [[TMP35]] = getelementptr inbounds [[STRUCT]], ptr [[TMP33]], i64 -1
; CHECK-NEXT:    [[TMP36:%.*]] = getelementptr [[STRUCT]], ptr [[TMP33]], i64 -1, i32 0
; CHECK-NEXT:    [[TMP37:%.*]] = load ptr, ptr [[TMP36]], align 8
; CHECK-NEXT:    [[TMP38:%.*]] = getelementptr [[STRUCT]], ptr [[TMP32]], i64 -2, i32 0
; CHECK-NEXT:    store ptr [[TMP37]], ptr [[TMP38]], align 8
; CHECK-NEXT:    [[TMP39:%.*]] = getelementptr [[STRUCT]], ptr [[TMP33]], i64 -1, i32 1
; CHECK-NEXT:    [[TMP40:%.*]] = load double, ptr [[TMP39]], align 8
; CHECK-NEXT:    [[TMP41:%.*]] = getelementptr [[STRUCT]], ptr [[TMP32]], i64 -2, i32 1
; CHECK-NEXT:    store double [[TMP40]], ptr [[TMP41]], align 8
; CHECK-NEXT:    [[IV]] = add nsw i64 [[TMP31]], -1
; CHECK-NEXT:    [[COND:%.*]] = icmp ugt i64 [[TMP31]], 1
; CHECK-NEXT:    br i1 [[COND]], label [[LOOP]], label [[EXIT]], !llvm.loop [[LOOP3:![0-9]+]]
; CHECK:       exit:
; CHECK-NEXT:    ret void
;
ph:
  ; By casting %a to %struct2 and using index 2, a maximum
  ; safe vector width is created since %struct only has an element at index
  ; 0 and index 1. In this example, a ptr is the same size as the double since
  ; we're using riscv64, so %b must be two 64 bit elements ahead of %a.
  %b = getelementptr inbounds %struct2, ptr %a, i64 0, i32 2
  br label %loop

loop:
  %0 = phi i64 [%n, %ph], [%iv, %loop]
  %1 = phi ptr [%a, %ph], [%3, %loop]
  %2 = phi ptr [%b, %ph], [%4, %loop]
  %3 = getelementptr inbounds %struct, ptr %1, i64 -1
  %4 = getelementptr inbounds %struct, ptr %2, i64 -1

  ; A[i-2].ptr = B[i-1].ptr
  %5 = getelementptr %struct, ptr %2, i64 -1, i32 0
  %6 = load ptr, ptr %5, align 8
  %7 = getelementptr %struct, ptr %1, i64 -2, i32 0
  store ptr %6, ptr %7, align 8

  ; A[i-2].double = B[i-1].double
  %8 = getelementptr %struct, ptr %2, i64 -1, i32 1
  %9 = load double, ptr %8, align 8
  %10 = getelementptr %struct, ptr %1, i64 -2, i32 1
  store double %9, ptr %10, align 8

  %iv = add nsw i64 %0, -1
  %cond = icmp ugt i64 %0, 1
  br i1 %cond, label %loop, label %exit

exit:
  ret void
}
