; CHECK-NEXT:    [[TMP40:%.*]] = load ptr, ptr [[TMP39]], align 8
; CHECK-NEXT:    [[TMP41:%.*]] = getelementptr [[STRUCT]], ptr [[TMP35]], i64 -2, i32 0
