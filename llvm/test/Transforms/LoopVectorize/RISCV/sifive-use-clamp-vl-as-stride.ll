; CHECK-NEXT:    [[TMP37]] = getelementptr inbounds [[STRUCT]], ptr [[TMP35]], i64 -1
; CHECK-NEXT:    [[TMP38]] = getelementptr inbounds [[STRUCT]], ptr [[TMP36]], i64 -1
