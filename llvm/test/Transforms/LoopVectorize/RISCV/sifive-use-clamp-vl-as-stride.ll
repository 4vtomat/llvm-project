; CHECK-NEXT:    [[INTERLEAVED_VEC:%.*]] = call <vscale x 2 x double> @llvm.experimental.vector.interleave2.nxv2f64(<vscale x 1 x double> [[TMP29]], <vscale x 1 x double> [[RESULT_REVERSE7]])
