entry:
  br label %for.body

for.body:
  %indvars.iv = phi i64 [ 0, %entry ], [ %indvars.iv.next, %if.end ]
  %red.036 = phi i32 [ 0, %entry ], [ %add18, %if.end ]
  %arrayidx = getelementptr inbounds i8, ptr %cond, i64 %indvars.iv
  %0 = load i8, ptr %arrayidx, align 1
  %tobool.not = icmp eq i8 %0, 0
  %.pre = mul nsw i64 %indvars.iv, %stride
  br i1 %tobool.not, label %if.end, label %if.then

if.then:
  %1 = mul nsw i64 %indvars.iv, %stride
  %arrayidx2 = getelementptr inbounds i32, ptr %a, i64 %.pre
  %2 = load i32, ptr %arrayidx2, align 4
  %add3 = add nsw i32 %2, %red.036
  br label %if.end

if.end:
  %red.1 = phi i32 [ %add3, %if.then ], [ %red.036, %for.body ]
  %3 = add nsw i64 %.pre, 1
  %arrayidx7 = getelementptr i32, ptr %a, i64 %3
  %4 = load i32, ptr %arrayidx7, align 4
  %add8 = add nsw i32 %red.1, %4
  %5 = add nsw i64 %.pre, 2
  %arrayidx12 = getelementptr i32, ptr %a, i64 %5
  %6 = load i32, ptr %arrayidx12, align 4
  %add13 = add nsw i32 %add8, %6
  %7 = add nsw i64 %.pre, 3
  %arrayidx17 = getelementptr i32, ptr %a, i64 %7
  %8 = load i32, ptr %arrayidx17, align 4
  %add18 = add nsw i32 %add13, %8
  %indvars.iv.next = add nuw nsw i64 %indvars.iv, 1
  %exitcond.not = icmp eq i64 %indvars.iv.next, %n
  br i1 %exitcond.not, label %exit, label %for.body

exit:
  ret i32 %add18
}

