  %0 = load i8, ptr %arrayidx, align 1
  %tobool.not = icmp eq i8 %0, 0
  %.pre = mul nsw i64 %indvars.iv, %stride
  br i1 %tobool.not, label %if.end, label %if.then

if.then:
  %1 = mul nsw i64 %indvars.iv, %stride
  %arrayidx2 = getelementptr inbounds i32, ptr %a, i64 %.pre
  %2 = load i32, ptr %arrayidx2, align 4
  %add3 = add nsw i32 %2, %red.036
  br label %if.end

