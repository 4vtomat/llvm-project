; Make sure we optimize the motivating case from TOOLCHAIN-1358 to vmslt+vmerge.
; TODO: Is it worthwhile to get rid of the bitcasts around riscv.vmerge
define i128 @cmp_select(i128 %a.coerce, i128 %b.coerce, i128 %c.coerce, i128 %d.coerce) {
; CHECK-LABEL: @cmp_select(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[I:%.*]] = bitcast i128 [[A_COERCE:%.*]] to <4 x i32>
; CHECK-NEXT:    [[I1:%.*]] = bitcast i128 [[B_COERCE:%.*]] to <4 x i32>
; CHECK-NEXT:    [[I2:%.*]] = call <vscale x 4 x i32> @llvm.riscv.vcast.from.fixed.nxv4i32.v4i32(<4 x i32> [[I]])
; CHECK-NEXT:    [[I3:%.*]] = call <vscale x 4 x i32> @llvm.riscv.vcast.from.fixed.nxv4i32.v4i32(<4 x i32> [[I1]])
; CHECK-NEXT:    [[I4:%.*]] = call <vscale x 4 x i1> @llvm.riscv.vmslt.nxv4i32.nxv4i32.i64(<vscale x 4 x i32> [[I2]], <vscale x 4 x i32> [[I3]], i64 4)
; CHECK-NEXT:    [[I8:%.*]] = bitcast i128 [[C_COERCE:%.*]] to <4 x float>
; CHECK-NEXT:    [[I9:%.*]] = bitcast i128 [[D_COERCE:%.*]] to <4 x float>
; CHECK-NEXT:    [[I11:%.*]] = call <vscale x 4 x float> @llvm.riscv.vcast.from.fixed.nxv4f32.v4f32(<4 x float> [[I8]])
; CHECK-NEXT:    [[I12:%.*]] = call <vscale x 4 x float> @llvm.riscv.vcast.from.fixed.nxv4f32.v4f32(<4 x float> [[I9]])
; CHECK-NEXT:    [[I13:%.*]] = bitcast <vscale x 4 x float> [[I12]] to <vscale x 4 x i32>
; CHECK-NEXT:    [[I14:%.*]] = bitcast <vscale x 4 x float> [[I11]] to <vscale x 4 x i32>
; CHECK-NEXT:    [[I17:%.*]] = call <vscale x 4 x i32> @llvm.riscv.vmerge.nxv4i32.nxv4i32.i64(<vscale x 4 x i32> undef, <vscale x 4 x i32> [[I13]], <vscale x 4 x i32> [[I14]], <vscale x 4 x i1> [[I4]], i64 4)
; CHECK-NEXT:    [[I18:%.*]] = bitcast <vscale x 4 x i32> [[I17]] to <vscale x 4 x float>
; CHECK-NEXT:    [[I19:%.*]] = call <4 x float> @llvm.riscv.vcast.to.fixed.v4f32.nxv4f32(<vscale x 4 x float> [[I18]])
; CHECK-NEXT:    [[I20:%.*]] = bitcast <4 x float> [[I19]] to i128
; CHECK-NEXT:    ret i128 [[I20]]
;
entry:
  %i = bitcast i128 %a.coerce to <4 x i32>
  %i1 = bitcast i128 %b.coerce to <4 x i32>
  %i2 = call <vscale x 4 x i32> @llvm.riscv.vcast.from.fixed.nxv4i32.v4i32(<4 x i32> %i)
  %i3 = call <vscale x 4 x i32> @llvm.riscv.vcast.from.fixed.nxv4i32.v4i32(<4 x i32> %i1)
  %i4 = call <vscale x 4 x i1> @llvm.riscv.vmslt.nxv4i32.nxv4i32.i64(<vscale x 4 x i32> %i2, <vscale x 4 x i32> %i3, i64 4)
  %i5 = call <vscale x 4 x i32> @llvm.riscv.vmv.v.x.nxv4i32.i64(<vscale x 4 x i32> undef, i32 0, i64 4)
  %i6 = call <vscale x 4 x i32> @llvm.riscv.vmerge.nxv4i32.i32.i64(<vscale x 4 x i32> undef, <vscale x 4 x i32> %i5, i32 -1, <vscale x 4 x i1> %i4, i64 4)
  %i7 = call <4 x i32> @llvm.riscv.vcast.to.fixed.v4i32.nxv4i32(<vscale x 4 x i32> %i6)
  %i8 = bitcast i128 %c.coerce to <4 x float>
  %i9 = bitcast i128 %d.coerce to <4 x float>
  %i10 = call <vscale x 4 x i32> @llvm.riscv.vcast.from.fixed.nxv4i32.v4i32(<4 x i32> %i7)
  %i11 = call <vscale x 4 x float> @llvm.riscv.vcast.from.fixed.nxv4f32.v4f32(<4 x float> %i8)
  %i12 = call <vscale x 4 x float> @llvm.riscv.vcast.from.fixed.nxv4f32.v4f32(<4 x float> %i9)
  %i13 = bitcast <vscale x 4 x float> %i12 to <vscale x 4 x i32>
  %i14 = bitcast <vscale x 4 x float> %i11 to <vscale x 4 x i32>
  %i15 = call <vscale x 4 x i32> @llvm.riscv.vxor.nxv4i32.nxv4i32.i64(<vscale x 4 x i32> undef, <vscale x 4 x i32> %i13, <vscale x 4 x i32> %i14, i64 4)
  %i16 = call <vscale x 4 x i32> @llvm.riscv.vand.nxv4i32.nxv4i32.i64(<vscale x 4 x i32> undef, <vscale x 4 x i32> %i15, <vscale x 4 x i32> %i10, i64 4)
  %i17 = call <vscale x 4 x i32> @llvm.riscv.vxor.nxv4i32.nxv4i32.i64(<vscale x 4 x i32> undef, <vscale x 4 x i32> %i13, <vscale x 4 x i32> %i16, i64 4)
  %i18 = bitcast <vscale x 4 x i32> %i17 to <vscale x 4 x float>
  %i19 = call <4 x float> @llvm.riscv.vcast.to.fixed.v4f32.nxv4f32(<vscale x 4 x float> %i18)
  %i20 = bitcast <4 x float> %i19 to i128
  ret i128 %i20
}

