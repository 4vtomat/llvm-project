; RUN: opt < %s -passes=instcombine,simplifycfg,instcombine -S | FileCheck %s

; Make sure InstCombine doesn't prevent this from being recognized as a min.
; The icmp and select should use the same operands after InstCombine and
; SimplifyCFG.
; We run InstCombine again after SimplifyCFG to make sure the pattern is stable
; when converted to select.

; NOTE: instcombine might convert this to a llvm.smin intrinsic in the future.
; If this happens RISCVCodeGenPrepare.cpp and test/CodeGen/RISCV/sifive-add-nsw-min.ll
; will need to be updated.

define signext i32 @foo(i32 signext %px, i32 signext %y) {
; CHECK-LABEL: @foo(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    [[ADD:%.*]] = add nsw i32 [[PX:%.*]], 1
; CHECK-NEXT:    [[TMP0:%.*]] = call i32 @llvm.smin.i32(i32 [[ADD]], i32 [[Y:%.*]])
; CHECK-NEXT:    ret i32 [[TMP0]]
;
entry:
  %add = add nsw i32 %px, 1
  %cmp = icmp sgt i32 %add, %y
  br i1 %cmp, label %if.then, label %if.end

if.then:
  br label %if.end

if.end:
  %x.0 = phi i32 [ %y, %if.then ], [ %add, %entry ]
  ret i32 %x.0
}
